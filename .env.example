# ═══════════════════════════════════════════════════════════════════════
# Nasaf Digital Tracker — environment o'zgaruvchilari namunasi
# ═══════════════════════════════════════════════════════════════════════
#
# ODATDA BU FAYLNI NUSXALASH SHART EMAS. Loyiha Vercel'da turadi,
# shuning uchun lokal qiymatlarni bitta buyruq olib keladi:
#
#     vercel env pull
#
# U `.env.local` faylini yozadi va hamma narsa shu yerdan yuklanadi.
# Bu fayl esa SPRAVOCHNIK: qaysi kalitlar bor, qaysisi majburiy.
#
# ── NEGA `.env` YARATMASLIK KERAK ──────────────────────────────────────
# Yuklovchi (scripts/_env.js) ikkala faylni o'qiydi — avval `.env.local`,
# keyin `.env` — va BIRINCHI topilgan qiymat qoladi. Demak qo'lda
# yozilgan `.env` jimgina eskirib boradi: `.env.local` qayta yuklangach
# yangi qiymatlar keladi, `.env` dagi eskisi esa tagida yotaveradi va
# `.env.local` o'chgan kuni o'rniga chiqib qoladi.
#
# Aynan shunday nosozlik ishlab chiqarishga yetib borgan: eski APP_URL
# sababli HAR BIR bildirishnomadagi "Ilovani ochish" tugmasi muzlab
# qolgan eski manzilga olib borardi (2026-09-11). Tafsilot:
# netlify/functions/lib/notify.js
#
# Holatni istalgan vaqtda tekshirish mumkin:
#
#     npm run env:check
#
# U nima yuklanganini, qaysi fayldan kelganini va ikki fayl orasida
# ziddiyat bor-yo'qligini ko'rsatadi (qiymatlarni oshkor qilmaydi).
#
# Ishlab chiqarishda bu fayllarning hech biri ishlatilmaydi — qiymatlar
# Vercel → Project Settings → Environment Variables dan olinadi.
# Batafsil: docs/SETUP.md
# ═══════════════════════════════════════════════════════════════════════


# ── MAJBURIY ────────────────────────────────────────────────────────────

# Supabase Postgres. Project Settings → Database → Connection string →
# "Transaction" rejimi (pooler, port 6543).
DATABASE_URL='postgresql://USER:PASSWORD@HOST:6543/postgres'

# @BotFather'dan: "/newbot" yoki mavjud bot uchun "/token"
BOT_TOKEN='000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'

# Cron chaqiruvlarini (rollover, eslatmalar) himoya qiladi.
# O'zingiz yarating: openssl rand -hex 16
CRON_SECRET='change-me-to-a-random-secret'


# ── MUHIM ───────────────────────────────────────────────────────────────

# Bildirishnoma yuboriladigan admin chat ID'lari (vergul bilan).
# @userinfobot orqali aniqlanadi.
ADMIN_CHAT_IDS='111111111,222222222'

# Ilovaning haqiqiy manzili — bildirishnomadagi "Ilovani ochish" tugmasi
# shu asosda quriladi. NOTO'G'RI bo'lsa tugma ishlamay qoladi, lekin
# hech qanday xato ko'rinmaydi — shuning uchun o'zgartirganda tekshiring.
APP_URL='https://nasaf-digital-tracker.vercel.app'

# Rasm va fayl yuklash (Vercel Blob). `vercel env pull` o'zi olib keladi.
BLOB_READ_WRITE_TOKEN='vercel_blob_rw_XXXXXXXX'


# ── IXTIYORIY ───────────────────────────────────────────────────────────

# Testlar uchun ALOHIDA baza. Berilmasa testlar ishga tushmaydi —
# test/_db-guard.js ataylab to'xtatadi, chunki testlar ma'lumot yaratib,
# keyin o'chiradi. Asosiy bazada ishlatish MUMKIN EMAS.
# TEST_DATABASE_URL='postgresql://USER:PASSWORD@HOST:6543/postgres_test'

# Kalendar rejalarini xodim pochtasiga taklifnoma qilib yuborish.
# Berilmasa xat yuborilmaydi, qolgan hamma narsa ishlayveradi — xodimlar
# rejalarni Profil → "Telefon kalendariga ulash" orqali ham oladi.
# RESEND_API_KEY='re_XXXXXXXX'
# MAIL_FROM='Nasaf Tracker <kalendar@nasafdigital.uz>'   # domen tasdiqlangan bo'lsin

# Mini App havolasi. BERISH SHART EMAS: bot nomi BOT_TOKEN dan getMe
# orqali o'zi topiladi. Faqat BotFather'da qisqa nomli ("named") Mini App
# ishlatilsa kerak bo'ladi.
# MINIAPP_URL='https://t.me/nasafdigital_bot/tracker'

# Faqat lokal (masalan Docker'dagi) Postgres'da SSL bo'lmasa.
# Supabase uchun tegmang.
# DATABASE_SSL=false


# ── LEGACY ──────────────────────────────────────────────────────────────
# Eski tizim JSONBin.io'da ishlagan. Migratsiya bir marta o'tgan —
# bular endi kerak emas, kod ularni faqat migrate-from-jsonbin.js da
# o'qiydi.
# JSONBIN_BIN_ID='your-bin-id'
# JSONBIN_KEY='your-master-key'

# ── Telegram guruhlari (ixtiyoriy) ──────────────────────────────────
# Bot guruhlardagi xabarlarni eshitishi uchun. Tartib muhim:
#   1) npm run tg:webhook -- secret   — kalit yaratadi
#   2) kalitni bu yerga VA Vercel'ga qo'yib, deploy qiling
#   3) npm run tg:webhook -- set      — webhook'ni o'rnatadi
# Teskarisi bo'lsa Telegram xabar yubora boshlaydi, server esa kalitni
# bilmagani uchun hammasini 403 bilan rad etadi va ular yo'qoladi.
TG_WEBHOOK_SECRET=
