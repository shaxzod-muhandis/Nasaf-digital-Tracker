# ═══════════════════════════════════════════════════════════════════════
# Nasaf Digital Tracker — environment o'zgaruvchilari namunasi
# ═══════════════════════════════════════════════════════════════════════
# Bu faylni nusxalab ".env" nomi bilan saqlang va haqiqiy qiymatlarni kiriting:
#   cp .env.example .env
# ".env" fayli git'ga HECH QACHON qo'shilmasligi kerak (.gitignore'da bor).
#
# Netlify'da deploy qilinganda bu qiymatlar ".env" fayldan emas, balki
# Netlify dashboard → Site settings → Environment variables orqali
# beriladi. Batafsil qo'llanma: docs/SETUP.md
# ═══════════════════════════════════════════════════════════════════════

# ── MA'LUMOTLAR BAZASI (Supabase Postgres) — MAJBURIY ────────────────────
# Supabase loyihangizda: Project Settings → Database → Connection string
# → "Transaction" rejimi (pooler, port 6543) tanlang. Namuna:
#   postgresql://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL='postgresql://USER:PASSWORD@HOST:6543/postgres'

# Faqat lokal (masalan Docker'dagi) Postgres'da SSL bo'lmasa "false" qiling.
# Supabase uchun har doim standart (SSL yoqilgan) holida qoldiring.
# DATABASE_SSL=false

# ── TELEGRAM BOT — MAJBURIY ──────────────────────────────────────────────
# @BotFather'dan olinadi ("/newbot" yoki mavjud bot uchun "/token")
BOT_TOKEN='000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'

# Bildirishnoma yuboriladigan admin/menejer chat ID'lari (vergul bilan).
# Botga /start bosgan har bir foydalanuvchining chat_id'sini shu yerga
# qo'shing (masalan @userinfobot orqali aniqlash mumkin).
ADMIN_CHAT_IDS='111111111,222222222'

# Cron chaqiruvlarini (rollover, eslatma) himoya qilish uchun maxfiy so'z —
# o'zingiz o'ylab toping (masalan: openssl rand -hex 16). cron-job.org yoki
# boshqa cron xizmatida so'rov header'iga "X-Cron-Secret" sifatida qo'shing.
CRON_SECRET='change-me-to-a-random-secret'

# ── LEGACY: faqat bir martalik JSONBin → Postgres migratsiyasi uchun ────
# Eski tizim JSONBin.io'da ishlagan. Agar hali "scripts/migrate-from-jsonbin.js"
# ishga tushirilmagan bo'lsa, quyidagilarni JSONBin dashboard'idan oling.
# Migratsiya bir marta muvaffaqiyatli o'tgach, bu ikkalasi umuman kerak emas
# — o'chirib tashlashingiz yoki shunday qoldirishingiz mumkin, ta'siri yo'q.
# XAVFSIZLIK ESLATMASI: agar avvalgi haqiqiy JSONBIN_KEY qandaydir joyda
# (masalan eski commit tarixida) oshkor bo'lgan bo'lsa, JSONBin dashboard
# orqali uni bekor qilib, yangisini yarating.
# JSONBIN_BIN_ID='your-bin-id'
# JSONBIN_KEY='your-master-key'
