{
  "regions": [
    "hnd1"
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/vazifalar/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/kalendar",
      "destination": "/api/index"
    },
    {
      "source": "/kalendar/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/fikr/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "private/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 3 * * *"
    }
  ]
}
